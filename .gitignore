.vscode/
publish-trial/

# Bundled rigctld (self-sufficiency plan, Phase 1) -- fetched by scripts\fetch-hamlib.ps1,
# not vendored, same reasoning as Nexus's own fetch-hamlib.sh keeping these out of source
# control (they're an official Hamlib release download, not something Jimmy authors).
WSJTX_Controller/Resources/hamlib/

# Rust build artifacts (self-sufficiency plan, Phase 4 -- EngineHost). Cargo.lock IS committed
# (binary crate, not a library -- reproducible builds matter more than lockfile churn here).
EngineHost/target/

# Build-generated staging checkout of official Nexus at the pinned revision (with
# EngineHost/nexus-compat/patches/ applied) -- created by scripts/prepare-nexus.ps1, never
# hand-edited, never committed. See EngineHost/nexus-compat/README.md.
EngineHost/.nexus-src/
EngineHost/.nexus-src-info.json

# build.bat's captured output log, not source
build_out.txt
