@@ -798,6 +798,22 @@ pub struct RadioStatus {
     /// why the waterfall is blank instead of failing silently.
     #[serde(default)]
     pub audio_error: Option<String>,
+    /// JIMMY COMPAT (see EngineHost/nexus-compat/README.md): set when a Fake-It dial restore is
+    /// UNRESOLVED — CAT failed after a temporary Fake-It shift and the radio loop cannot
+    /// confirm the operating dial was put back. A concise operator-facing string so Jimmy can
+    /// raise a persistent, accessible warning rather than silently leaving the operator on an
+    /// unknown VFO frequency. `None` (the default) in normal operation — a healthy immediate
+    /// restore never sets it, and it clears the moment the loop reconciles the dial.
+    #[serde(default)]
+    pub fake_it_restore_warning: Option<String>,
+    /// JIMMY COMPAT (see EngineHost/nexus-compat/README.md): a monotonic id for the CURRENT
+    /// unresolved Fake-It episode, bumped once on each fresh transition into "unresolved" and
+    /// stable for that episode's life. `Some` iff `fake_it_restore_warning` is `Some`. Jimmy
+    /// pairs it with the snapshot's session token so the SAME still-unresolved episode is
+    /// announced only once even across a Direct transport reconnect, while a genuinely new
+    /// episode (identical wording included) still announces.
+    #[serde(default)]
+    pub fake_it_restore_warning_id: Option<u64>,
     /// Set when two enabled radios are configured on the SAME serial COM port — the
     /// monitor radio's CAT can't open the busy port and shows a confusing red pill.
     /// A config warning (self-clears once the ports differ); surfaced in the status lane.
