+/// JIMMY COMPAT (see EngineHost/nexus-compat/README.md): `Path::canonicalize()` on Windows
+/// returns the `\\?\`-prefixed "verbatim" form. CMake accepts it fine as `-S`, but bakes it into
+/// every generated Ninja/Makefile rule; MSYS2/MinGW gfortran (invoked by CMake to compile the
+/// Fortran modem sources) does not understand that prefix once it reaches its own path handling
+/// and mis-splits it, failing with "No such file or directory" naming only the last path segment
+/// — a full rebuild from a fresh build dir fails every Fortran compile step this way.
+/// Symlinks and `..` are already resolved by `canonicalize()` by the time this runs, so stripping
+/// the prefix changes nothing except making the string one that non-Rust-aware external tools
+/// can actually parse. No-op on non-Windows, where `canonicalize()` never produces this prefix.
+fn strip_verbatim_prefix(p: PathBuf) -> PathBuf {
+    match p.to_str().and_then(|s| s.strip_prefix(r"\\?\")) {
+        Some(stripped) => PathBuf::from(stripped),
+        None => p,
+    }
+}
