+    /// QSO completes on it -- as WSJT-X's normal mode does -- and is logged exactly once.
+    #[test]
+    fn an_ordinary_qso_completes_on_its_own_partners_multi_answer_roger() {
+        let mut e = Engine::new("W9XYZ", "EN37", 0);
+        e.set_tier(Tier::Ft8);
+        e.ingest_decodes_for_test(&[dec_at("CQ PJ4DX", -10, 400.0)], 1);
+        let _ = e.call_station_ctx("PJ4DX", None, Some("CQ PJ4DX"), Some(-10), Some(400.0));
+        e.ingest_decodes_for_test(&[dec_at("W9XYZ PJ4DX -08", -10, 400.0)], 3);
+        // The genuine frame, plus an UNRELATED decode with identical snr/dt/freq and free text
+        // that merely contains ';' (hound_split divides that too).
+        e.ingest_decodes_for_test(
+            &[
+                dec_at("W9XYZ RR73; K1ABC <PJ4DX> -12", -10, 400.0),
+                dec_at("K2DEF <K5MGY> -12", -10, 400.0),
+                dec_at("TNX FB; 73 GL", -10, 400.0),
+            ],
+            5,
+        );
+        assert_eq!(
+            e.stored_log().len(),
