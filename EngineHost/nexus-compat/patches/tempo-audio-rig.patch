+/// boolean: `RIG_PTT_ON` (1) is generic, while `RIG_PTT_ON_MIC` (2) / `RIG_PTT_ON_DATA` (3) tell
+/// a rig with separate mic/data audio inputs which one to transmit from. `data_source` mirrors
+/// WSJT-X's own "Transmit Audio Source: Data" radio button (`HamlibTransceiver::do_ptt`'s
+/// `back_ptt_port_` check) — operator-configured, off by default, exactly like WSJT-X's own
+/// `TXAudioSource` setting (default `TX_audio_source_front`). Backends that don't distinguish
+/// mic/data treat any nonzero value as plain PTT-on, so sending `RIG_PTT_ON` unconditionally
+/// when `data_source` is off is safe generally.
+pub fn ptt_line(on: bool, data_source: bool) -> String {
+    let v = if !on { 0 } else if data_source { 3 } else { 1 };
+    format!("T {v}\n")
