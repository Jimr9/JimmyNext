+    // ───────────────────────────── JIMMY COMPAT (nexus-compat) ─────────────────────────────
+    // Deterministic scripted proof for the downstream compatibility patches. See
+    // EngineHost/nexus-compat/README.md.
+
+    /// Do-not-set-mode: when the operator has picked WSJT-X "Mode: None", the loop issues no
+    /// `M` CAT command at all, for any mode. Positive control: without it, a retune commands `M`.
+    #[test]
+    fn jimmy_compat_dont_set_mode_emits_no_mode_command() {
+        let m_cmds = |dont_set_mode: bool| -> Vec<String> {
+            let engine = Arc::new(Mutex::new(Engine::new("W9XYZ", "EN37", 0)));
+            {
+                let mut e = engine.lock().unwrap();
+                let mut s = e.settings().clone();
+                s.dont_set_mode = dont_set_mode;
+                e.apply_settings(s);
+                e.set_operating_mode("digital", false);
+                e.set_frequency(14.074, "20m", "USB");
+            }
+            let (addr, log) = mock_rigctld_on(14_074_000, false);
+            let mut rig = Rig::rigctld(&addr);
+            let mut backend = MockBackend::new();
+            let mut state = loop_state();
+            let (sinks, mut ra, mut rr) = (no_sinks(), mock_reopen_audio(), mock_reopen_rig());
+            let mut station = StationSinks::new();
+            let mut run = |state: &mut RadioLoop, rig: &mut Rig, t: f64| {
+                state
+                    .step(&engine, &mut backend, rig, &sinks, t, &mut ra, &mut rr, &mut station)
+                    .unwrap();
+            };
+            let mark = log.lock().unwrap().len();
+            for i in 0..4 {
+                run(&mut state, &mut rig, f64::from(i) * 300.0);
+            }
+            let out: Vec<String> = log.lock().unwrap()[mark..]
+                .iter()
+                .filter(|l| l.starts_with("M "))
+                .cloned()
+                .collect();
+            out
+        };
+        assert_eq!(
+            m_cmds(true),
+            Vec::<String>::new(),
+            "Mode: None must leave the rig's mode entirely alone"
+        );
+        assert!(
+            !m_cmds(false).is_empty(),
+            "positive control: without Mode: None a retune DOES command the rig mode"
+        );
+    }
+
