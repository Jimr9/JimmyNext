 const CAT_REOPEN_MAX_MS: f64 = 300_000.0;
+
+/// JIMMY COMPAT (see EngineHost/nexus-compat/README.md): the state of a Fake-It dial restore the
+/// loop still owes. Every value is a PHYSICAL fact about the radio (a CAT-confirmed reading),
+/// never a cached/logical engine dial.
+#[derive(Clone, Copy, Debug, PartialEq, Default)]
+enum FakeItRestore {
+    /// Nothing owed — the normal state.
+    #[default]
+    None,
+    /// A shifted over just ended; the ONE immediate restore attempt has not run yet. The
+    /// teardown resolves it on the first safe tick after unkey.
+    Armed {
+        original_hz: u64,
+        shifted_to_hz: u64,
+        /// See [`crate::slot::FakeItShift::shift_confirmed`] — `false` = the shift command's
+        /// outcome was ambiguous (transport error), so the reconciliation runs on the physical
+        /// readback, not on this flag.
+        shift_confirmed: bool,
+    },
+    /// The immediate attempt could not CONFIRM the dial was put back (CAT unhealthy, `F`
+    /// refused, or the read-back did not match). NOT retried on idle ticks — it waits for a
+    /// trustworthy CAT-recovery / heavy-poll reading, gets AT MOST one more corrective `F`
+    /// (`recovery_tried`), and is exposed to Jimmy as a persistent warning meanwhile.
+    Unresolved {
+        original_hz: u64,
+        shifted_to_hz: u64,
+        recovery_tried: bool,
+    },
+}
+
+impl FakeItRestore {
+    fn dials(&self) -> Option<(u64, u64)> {
+        match *self {
+            FakeItRestore::None => None,
+            FakeItRestore::Armed { original_hz, shifted_to_hz, .. }
+            | FakeItRestore::Unresolved { original_hz, shifted_to_hz, .. } => {
+                Some((original_hz, shifted_to_hz))
+            }
+        }
+    }
+    fn is_none(&self) -> bool {
+        matches!(self, FakeItRestore::None)
+    }
+    fn is_unresolved(&self) -> bool {
+        matches!(self, FakeItRestore::Unresolved { .. })
+    }
+}
+
+/// The three-way reconciliation of a pending Fake-It restore against a freshly-read PHYSICAL
+/// dial (Codex correction E). EXACT integer-Hz equality — rigctld frequencies are whole Hz and
+/// Nexus carries no per-rig tuning-resolution that would justify a tolerance.
+enum FakeItReconcile {
+    /// Physical dial is already the pre-shift original — restored, or the shift never took.
+    AlreadyHome,
+    /// Physical dial is still the temporary Fake-It dial — put the original back.
+    Restore,
+    /// Physical dial is neither — a NEWER operator/external frequency. Never overwrite it.
+    OperatorMoved,
+}
+
+fn classify_fake_it(cur_hz: u64, original_hz: u64, shifted_to_hz: u64) -> FakeItReconcile {
+    if cur_hz == original_hz {
+        FakeItReconcile::AlreadyHome
+    } else if cur_hz == shifted_to_hz {
+        FakeItReconcile::Restore
+    } else {
+        FakeItReconcile::OperatorMoved
+    }
+}
