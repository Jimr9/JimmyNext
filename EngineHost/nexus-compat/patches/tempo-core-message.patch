+/// A slash-free call that `pack77_1` accepts in a two-word Type 1 message: WSJT-X's
+/// `chkcall.f90` test (base of at most 6 characters, a letter in position 1 or 2, a digit in
+/// position 2 or 3 followed by a 1-3 letter suffix, no leading `Q` except the QU1RK
+/// placeholder) and also [`is_std_call`], so it can ride the standard c28 field.
+fn is_plain_std_call(s: &str) -> bool {
+    let b = s.as_bytes();
+    if b.is_empty() || b.len() > 6 || !b.iter().all(|c| c.is_ascii_uppercase() || c.is_ascii_digit()) {
+        return false;
+    }
+    let letter = |i: usize| b.get(i).is_some_and(|c| c.is_ascii_uppercase());
+    let digit = |i: usize| b.get(i).is_some_and(|c| c.is_ascii_digit());
+    if !letter(0) && !letter(1) {
+        return false;
+    }
+    if b[0] == b'Q' && !s.starts_with("QU1RK") {
+        return false;
+    }
+    let i1 = if digit(2) {
+        2
+    } else if digit(1) {
+        1
+    } else {
+        return false;
+    };
+    let suffix = &b[i1 + 1..];
+    (1..=3).contains(&suffix.len()) && suffix.iter().all(|c| c.is_ascii_uppercase()) && is_std_call(s)
+}
+
+/// Can `s` occupy a CALLSIGN FIELD of a standard message? [`looks_like_call`], plus -- when
+/// `leading` -- the three tokens WSJT-X lets stand in the first field instead of a call.
+/// Backported from upstream #303 (kd9taw/Nexus 0c68f705) in Jimmy Next's
+/// tempo-core-message.patch. `DE`/`CQ`/`QRZ` are exempt in the FIRST field only, exactly as
+/// `pack77_1` has it (packjt77.f90:1178-1179), which keeps the #303 shape ("KD9TAW DE EM73") out.
+fn is_call_field(s: &str, leading: bool) -> bool {
+    looks_like_call(s) || (leading && matches!(s, "DE" | "CQ" | "QRZ"))
+}
+
 pub fn looks_like_call(s: &str) -> bool {
     is_valid_hashed(s) || is_compound(s) || is_callsign(s)
 }
