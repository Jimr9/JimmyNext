<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jimmy Next installer - WiX 5 source, mirrors Jimmy.wxs exactly except for the
  identity/isolation changes needed to install SIDE BY SIDE with a production
  Jimmy install on the same machine, rather than upgrading/replacing it:
    - Different Package Name ("Jimmy Next") and INSTALLFOLDER ("Jimmy Next").
    - A FRESH UpgradeCode (never reuse production's {D5415907-...}, nor the
      retired "Jimmy Test" flavor's {BFC5D246-...}); reusing either would make
      this a major upgrade of that product instead of a separate, coexisting
      one; Jimmy Next testers uninstall Jimmy Test manually first, they are
      not upgraded in place.
    - Different shortcut names and HKCU registry key path (Software\KB0UZT\
      "Jimmy Next" instead of "Jimmy"), so the two installs' shortcuts/registry
      state never collide.
    - Target exe is "Jimmy Next.exe" (AssemblyName overridden at publish time),
      which also makes Jimmy's OWN runtime data folder isolate automatically
      (%LocalAppData%\Jimmy Next\ instead of %LocalAppData%\Jimmy\; see
      LookupManager.DataRoot and Controller.cs's pgmName, both derived from the
      running assembly's own name), so this build never reads or writes
      the production install's real settings/logbook database.

  Product  : Jimmy Next (WSJT-X Controller, public beta build)
  Version  : 2.0.48
  Mfr      : KB0UZT
  Install  : C:\Program Files\KB0UZT\Jimmy Next\
  Shortcuts: Desktop + Start Menu (optional checkboxes, both on by default)

  PublishOutputNext\ is produced by (self-contained, distinct AssemblyName):
    dotnet publish ..\WSJTX_Controller\Jimmy.csproj -c Release -p:AssemblyName="Jimmy Next" -p:SelfContained=true -r win-x64 -o PublishOutputNext
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="Jimmy Next"
    Version="2.0.48"
    Manufacturer="KB0UZT"
    Language="1033"
    Codepage="1252"
    UpgradeCode="{594D5C69-67A3-40E2-A5D9-68289DCAB98A}"
    InstallerVersion="500"
    Compressed="yes">

    <SummaryInformation Description="Jimmy Next (WSJT-X Controller) Installer" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon for Add/Remove Programs. Sourced directly from Properties\, same as
         Jimmy.wxs: never copied into build/publish output either before or after
         the migration (ApplicationIcon embeds it into the exe resource directly;
         this is a separate loose-file reference). -->
    <Icon Id="JimmyNextIcon" SourceFile="..\WSJTX_Controller\Properties\netfol.ico" />
    <Property Id="ARPPRODUCTICON" Value="JimmyNextIcon" />
    <Property Id="ARPCONTACT" Value="KB0UZT" />

    <!-- Standard dialog set: Welcome -> InstallDir (Browse) -> VerifyReady -> Progress -> Finish -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <!-- Custom UI fragment that adds ShortcutsDlg and overrides the dialog chain -->
    <UIRef Id="JimmyNextUI" />

    <!-- Shortcut options: 1 = create (checked), empty = skip (unchecked).
         Both default checked. Secure passes them from UI to elevated execute sequence. -->
    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="STARTMENU_SHORTCUT" Value="1" Secure="yes" />

    <!-- "Launch Jimmy Next" checkbox on the Finish page. Setting the TEXT property is what
         makes WixUI_InstallDir's stock ExitDialog show the optional checkbox at all; the
         second property defaults it checked. The Finish button's DoAction publish that acts
         on it is in the JimmyNextUI fragment below. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Jimmy Next" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- No .NET Framework launch-condition check: the self-contained win-x64
         publish carries its own .NET 10 runtime, so there is no prerequisite to
         verify before installing. -->

    <Feature Id="DefaultFeature" Title="Jimmy Next" Level="1">
      <ComponentGroupRef Id="PublishComponents" />
      <ComponentGroupRef Id="RuleDefinitionsComponents" />
      <ComponentGroupRef Id="RuleDefinitionsListsComponents" />
      <ComponentGroupRef Id="ResourcesComponents" />
      <ComponentGroupRef Id="ResourcesEngineHostComponents" />
      <ComponentGroupRef Id="ResourcesHamlibComponents" />
      <ComponentGroupRef Id="ResourcesEngineHostHamlibComponents" />
      <ComponentRef Id="DesktopShortcutComp" />
      <ComponentRef Id="StartMenuShortcutComp" />
    </Feature>

    <!-- Pre-warm Windows Defender's scan of jimmy-engine-host.exe during install, not the
         operator's first use of Native mode. Confirmed live, 2026-08-07: a real tester's
         machine froze solid (no keyboard, no mouse, "busy" cursor) the first time Jimmy
         launched this exe, because Process.Start() sits directly on Jimmy's UI thread with
         nothing async about it; Defender's real-time scan of a brand-new, unsigned
         executable it has never seen before can take real time, and that whole wait landed
         on the UI thread. Confirmed the connection live too: disabling real-time protection
         made the freeze go away. Running the exe once, harmlessly, right here during
         installation (where a brief pause is normal and expected, and nothing is on Jimmy's
         own UI thread) means Defender has already scanned and cached its verdict on this
         exact file by the time the operator ever touches Native mode; the same
         Process.Start() call should then return immediately. The list-devices flag used
         below is the same one NativeEngineClient.ListAudioDevices() already uses at
         Options-dialog-open time (WSJTX_Controller\NativeEngineClient.cs), a real,
         already-proven-safe, side-effect-free enumeration, not a throwaway/invalid
         invocation. Return="ignore": this must never fail the install itself (a slow/failed
         scan here is just a missed optimization, not a real problem), deliberately
         best-effort, matching the "never a build/install error, only ever a harmless no-op"
         convention used elsewhere in this codebase (see Jimmy.csproj's own comments on the
         hamlib/EngineHost Include items). Execute="deferred" plus Impersonate="no": runs
         elevated (as the MSI already does), after the real files are on disk, not still
         inside a pending install transaction. -->
    <CustomAction Id="PreWarmEngineHostScan"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]Resources\EngineHost\jimmy-engine-host.exe&quot; --list-devices"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Launches Jimmy Next when the operator leaves the Finish page with the "Launch Jimmy
         Next" checkbox ticked. Same Directory plus quoted [INSTALLFOLDER] path shape as
         PreWarmEngineHostScan above, so no WiX extension is needed. Impersonate="yes" runs it
         as the logged in user (not elevated; the app must not run as admin). Execute defaults
         to immediate, which is correct for an ExitDialog action (it fires in the UI sequence,
         after the install transaction has committed). Return="asyncNoWait" lets the installer
         window close without waiting on the app. -->
    <CustomAction Id="LaunchJimmyNext"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]Jimmy Next.exe&quot;"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="PreWarmEngineHostScan" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>

  <!-- ── Directory structure ────────────────────────────────────────────── -->
  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="ManufacturerDir" Name="KB0UZT">
        <Directory Id="INSTALLFOLDER" Name="Jimmy Next">
          <!-- Declared explicitly (not left to harvesting) for RuleDefinitions\
               and Resources\, because both mix direct files with a
               subdirectory; this is exactly the known WiX 5 harvesting bug
               (wixtoolset/issues#8608) already found and fixed in production's
               own Jimmy.wxs: a folder that has both won't get harvested as
               one Directory row, it gets duplicate rows with the same name.
               Every other folder here (each locale subfolder) is leaf-only, so
               plain recursive harvesting is safe for those. -->
          <Directory Id="RuleDefinitionsDir" Name="RuleDefinitions">
            <Directory Id="RuleDefinitionsListsDir" Name="Lists" />
          </Directory>
          <Directory Id="ResourcesDir" Name="Resources">
            <Directory Id="ResourcesEngineHostDir" Name="EngineHost">
              <!-- Nexus/EngineHost owns launching and controlling rigctld; Jimmy Next never
                   independently launches or owns a second one for this path. Nexus's own
                   official build does not embed/build Hamlib into any crate (confirmed:
                   tempo-fast-sys's build.rs has zero hamlib/rigctld references); it EXPECTS
                   the consuming application to package it, exactly like Nexus's own official
                   Tauri app does at src-tauri/resources/hamlib/ (staged by Nexus's own
                   scripts/fetch-hamlib.sh); resolve_rigctld's "resources/hamlib/rigctld.exe"
                   candidate exists specifically to match that convention. Jimmy's own
                   fetch-hamlib.ps1 already mirrors that script exactly (same release, same
                   file list, same checksum) for WSJTX_Controller's own Resources\hamlib\
                   (used by Jimmy's own RigctldClient.cs, a separate read-mostly telemetry
                   client; see Controller.cs's ApplyRadioSettings). This second copy just
                   supplies the SAME already-fetched bytes at a second location
                   resolve_rigctld's candidate list already searches relative to
                   jimmy-engine-host.exe's own directory ("hamlib/rigctld.exe"); Nexus still
                   does all the launching, Jimmy only supplies the binary, and zero Nexus
                   source is touched. -->
              <Directory Id="ResourcesEngineHostHamlibDir" Name="hamlib" />
            </Directory>
            <Directory Id="ResourcesHamlibDir" Name="hamlib" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />
  </Fragment>

  <!-- ── Harvested publish output ───────────────────────────────────────────
       Recursively harvests every file under PublishOutputNext\ (the self-
       contained win-x64 publish: "Jimmy Next.exe"/.dll, the .NET 10 runtime,
       SQLite.Interop.dll, MQTTnet*.dll, clublog_key.txt, Resources\*.wav, and
       the satellite-resource culture subfolders), preserving directory
       structure under INSTALLFOLDER automatically. RuleDefinitions\ is
       excluded here and harvested separately below (see the Directory
       declaration above for why). ────────────────────────────────────── -->
  <Fragment>
    <ComponentGroup Id="PublishComponents" Directory="INSTALLFOLDER">
      <Files Include="PublishOutputNext\**">
        <Exclude Files="PublishOutputNext\RuleDefinitions\**" />
        <Exclude Files="PublishOutputNext\Resources\**" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="RuleDefinitionsComponents" Directory="RuleDefinitionsDir">
      <Files Include="PublishOutputNext\RuleDefinitions\*" />
    </ComponentGroup>

    <ComponentGroup Id="RuleDefinitionsListsComponents" Directory="RuleDefinitionsListsDir">
      <Files Include="PublishOutputNext\RuleDefinitions\Lists\*" />
    </ComponentGroup>

    <!-- Resources\ split the same way as RuleDefinitions\ above, for the same reason
         (mixed direct files + subdirectories; see the Directory declaration's own
         comment). -->
    <ComponentGroup Id="ResourcesComponents" Directory="ResourcesDir">
      <Files Include="PublishOutputNext\Resources\*" />
    </ComponentGroup>

    <ComponentGroup Id="ResourcesEngineHostComponents" Directory="ResourcesEngineHostDir">
      <Files Include="PublishOutputNext\Resources\EngineHost\*" />
    </ComponentGroup>

    <ComponentGroup Id="ResourcesHamlibComponents" Directory="ResourcesHamlibDir">
      <Files Include="PublishOutputNext\Resources\hamlib\*" />
    </ComponentGroup>

    <!-- A second physical on-disk copy of the same hamlib files, published separately by
         Jimmy.csproj into PublishOutputNext\Resources\EngineHost\hamlib\ (see that project's
         own comment): WiX's file harvesting dedupes by SOURCE path, so pointing a second
         <Files Include> at the SAME Resources\hamlib\ source silently harvests nothing (found
         via a real build: WIX8602 "Skipping file that has already been harvested" on every
         file). Harvesting a second, genuinely distinct source path is what actually works. -->
    <ComponentGroup Id="ResourcesEngineHostHamlibComponents" Directory="ResourcesEngineHostHamlibDir">
      <Files Include="PublishOutputNext\Resources\EngineHost\hamlib\*" />
    </ComponentGroup>
  </Fragment>

  <!-- ── Shortcuts ──────────────────────────────────────────────────────── -->
  <Fragment>

    <!-- Desktop shortcut: only installed when checkbox is checked.
         Component Condition is evaluated at InstallValidate; empty property = absent. -->
    <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Condition="DESKTOP_SHORTCUT">
      <Shortcut Id="DesktopSC"
                Name="Jimmy Next"
                Description="WSJT-X Controller (public beta build)"
                Target="[INSTALLFOLDER]Jimmy Next.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="JimmyNextIcon"
                IconIndex="0" />
      <RegistryValue Root="HKCU"
                     Key="Software\KB0UZT\Jimmy Next"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Start Menu shortcut: only installed when checkbox is checked -->
    <Component Id="StartMenuShortcutComp" Directory="ProgramMenuFolder" Condition="STARTMENU_SHORTCUT">
      <Shortcut Id="StartMenuSC"
                Name="Jimmy Next"
                Description="WSJT-X Controller (public beta build)"
                Target="[INSTALLFOLDER]Jimmy Next.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="JimmyNextIcon"
                IconIndex="0" />
      <RegistryValue Root="HKCU"
                     Key="Software\KB0UZT\Jimmy Next"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

  </Fragment>

  <!-- Firewall exceptions: intentionally not added. See production Jimmy.wxs / the retired
       Jimmy Test flavor's own history for why; every listener either program can ever open
       in the actual packaged build is loopback-only (127.0.0.1), which Windows Firewall
       never filters and never prompts for. Nothing here needs LAN reachability. -->

  <!-- ── UI customizations ─────────────────────────────────────────────── -->
  <!--
    WiX 5 merges multiple <UI> fragments into one MSI UI section.
    This fragment adds ShortcutsDlg into the dialog chain after InstallDirDlg.

    Fresh-install flow:
      WelcomeDlg -> InstallDirDlg (Browse) -> ShortcutsDlg (checkboxes) -> VerifyReadyDlg (Install) -> ExitDlg (Finish)

    Override strategy:
      - Order=5 on InstallDirDlg Next fires after the built-in Order=4 (->VerifyReadyDlg),
        using the same validity condition so invalid paths still block progression.
      - Order=2 on VerifyReadyDlg Back fires after the built-in Order=1 (->InstallDirDlg),
        redirecting back to ShortcutsDlg instead.
  -->
  <Fragment>
    <UI Id="JimmyNextUI">
      <!-- Skip LicenseAgreementDlg: WelcomeDlg Next -> InstallDirDlg (Order=5 overrides built-in Order=1->LicenseAgreementDlg) -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="5"
               Condition="NOT Installed" />

      <!-- Fix InstallDirDlg Back to return to WelcomeDlg (not LicenseAgreementDlg) -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="5" />

      <!-- Route: InstallDirDlg Next -> ShortcutsDlg -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5"
               Condition='WIXUI_DONTVALIDATEPATH OR Installed OR PATCH OR WIXUI_INSTALLDIR_VALID = "1"' />

      <!-- Route: VerifyReadyDlg Back -> ShortcutsDlg (fresh install only) -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="2"
               Condition="NOT Installed AND NOT PATCH" />

      <!-- Finish: launch the app if the ExitDialog "Launch Jimmy Next" checkbox is ticked.
           Fresh install or major upgrade only (never on repair or remove). The checkbox
           itself is supplied by WixUI_InstallDir's stock ExitDialog, made visible and
           labelled by WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT (Package section). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchJimmyNext"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />

      <!-- ── ShortcutsDlg ──────────────────────────────────────────── -->
      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="[ProductName] Setup">

        <!-- Banner matching WixUI inner-dialog style -->
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <!-- Title (bold WixUI font) and subtitle -->
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}Shortcuts" />
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Select which shortcuts to create for [ProductName]." />

        <!-- Checkbox: Desktop shortcut -->
        <Control Id="DesktopCheckBox" Type="CheckBox" X="20" Y="90" Width="290" Height="17"
                 Property="DESKTOP_SHORTCUT" CheckBoxValue="1"
                 Text="&amp;Create Desktop shortcut" />

        <!-- Checkbox: Start Menu shortcut -->
        <Control Id="StartMenuCheckBox" Type="CheckBox" X="20" Y="112" Width="290" Height="17"
                 Property="STARTMENU_SHORTCUT" CheckBoxValue="1"
                 Text="Create &amp;Start Menu shortcut" />

        <!-- Bottom separator -->
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <!-- Back: return to InstallDirDlg -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>

        <!-- Next: proceed to VerifyReadyDlg (Install button) -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>

        <!-- Cancel: confirm cancellation -->
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

      </Dialog>
    </UI>
  </Fragment>

</Wix>
