<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage B2/B3 (migration roadmap): SDK-style + PackageReference conversion.
    TargetFramework now matches Jimmy.exe itself (net10.0-windows) now that
    Stage B3 has converted it, because a CoreCLR process cannot load a .NET
    Framework 4.7.2 assembly at runtime (System.BadImageFormatException),
    so this had to wait until Jimmy.exe's own TFM changed too.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>JimmyTests</AssemblyName>
    <RootNamespace>JimmyTests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="JimmyTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference Jimmy's managed assembly to test its parser types directly.
         On net10.0-windows, Jimmy.exe is a native apphost launcher stub (no CLR
         metadata); the actual managed assembly is Jimmy.dll alongside it. -->
    <!-- Build Jimmy first (run build.bat or test.bat). -->
    <!-- "Jimmy Test.dll", not "Jimmy.dll": 2026 08 10, build.bat now compiles Jimmy.csproj
         with AssemblyName="Jimmy Test" so local Debug builds never share production's
         LocalAppData identity (see build.bat's own comment); this reference has to name
         the same output file build.bat now actually produces. -->
    <Reference Include="Jimmy Test">
      <HintPath>..\WSJTX_Controller\bin\Debug\net10.0-windows\Jimmy Test.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- SQLite managed DLL, needed for LogbookDb tests. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

</Project>
