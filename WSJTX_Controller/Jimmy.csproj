<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WSJTX_Controller</RootNamespace>
    <AssemblyName>Jimmy</AssemblyName>
    <ApplicationIcon>netfol.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- WFO1000: WinForms-designer serialization-visibility analyzer. Jimmy's Controller.cs
         has plain pass-through properties (advancedCallLayout etc.) that are never touched by
         the visual designer (Designer.cs is hand-maintained), so this design-time-only
         completeness check has no runtime relevance here. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="MQTTnet.Extensions.ManagedClient" Version="4.3.7.1207" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Blip.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Chime.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Dive.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Echo.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Trumpet.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\BeepBeep.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\DingDing.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="netfol.ico" />
    <Content Include="Properties\netfol.ico" />
    <Content Include="Resources\netfol.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Starter Rule Definition library, seeded into %LocalAppData%\Jimmy\Data\RuleDefinitions
         on first run. Any file dropped under this folder is picked up automatically. -->
    <None Include="RuleDefinitions\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled rigctld (self-sufficiency plan, Phase 1), staged here by
         fetch-hamlib.ps1, not committed to source control (see .gitignore).
         Whatever the fetch script stages (rigctld.exe, rigctl.exe, and Hamlib's DLLs
         and attribution files) is picked up automatically, same "any file dropped
         under this folder" convention as RuleDefinitions above. Absent means the
         folder doesn't exist yet (fetch script not run); Include on a missing path
         is a harmless no-op in MSBuild, not a build error, so Jimmy still builds
         fine before the first fetch. -->
    <None Include="Resources\hamlib\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Rust Native engine host (self-sufficiency plan Phase 5); built separately via a
         cargo release build in EngineHost\, not part of this C# project's own build, so
         MSBuild has to be told about it explicitly (it lives outside WSJTX_Controller\,
         unlike Resources\hamlib\ above, which is a plain recursive Include since it's
         already nested under this project). Landed at Resources\EngineHost\ in the output;
         that's NativeEngineClient.LocateExe()'s primary lookup path, so a genuinely
         standalone/installed copy can find it too, not just a dev build run from inside a
         full git checkout (LocateExe()'s OTHER fallback, walking up to a sibling
         EngineHost\target\release\ folder, only ever resolves there; confirmed live,
         2026-08-07, missing entirely, and silently breaking Native mode with no crash,
         just a dead engine and a dead radio connection, on a real tester's standalone
         install). Absent (repo cloned but the Rust side never built) is a harmless no-op in
         MSBuild, same convention as the hamlib Include above; Jimmy still builds fine
         without it, just can't use Native mode. -->
    <None Include="..\EngineHost\target\release\jimmy-engine-host.exe;&#xD;&#xA;                    ..\EngineHost\target\release\libfftw3f-3.dll;&#xD;&#xA;                    ..\EngineHost\target\release\libgcc_s_seh-1.dll;&#xD;&#xA;                    ..\EngineHost\target\release\libgfortran-5.dll;&#xD;&#xA;                    ..\EngineHost\target\release\libquadmath-0.dll;&#xD;&#xA;                    ..\EngineHost\target\release\libstdc++-6.dll;&#xD;&#xA;                    ..\EngineHost\target\release\libwinpthread-1.dll">
      <Link>Resources\EngineHost\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Jimmy's Club Log application key lives in a private file outside the
       repo, never an environment variable and never source control. Only the
       path and line number are recorded here (this is a personal machine path,
       not the key itself). -->
  <PropertyGroup>
    <ClubLogKeyFile>C:\Users\Jim\Dropbox\amateur radio\Keys_private\Club Log API key for Jimmy.txt</ClubLogKeyFile>
    <ClubLogKeyLineNumber>9</ClubLogKeyLineNumber>
  </PropertyGroup>

  <!-- Reads a single line out of ClubLogKeyFile without ever logging its
       content. MSBuild has no built-in "read line N of a file" task, so this
       is a small inline task via RoslynCodeTaskFactory. -->
  <UsingTask TaskName="ReadClubLogKeyLine" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <LineNumber ParameterType="System.Int32" Required="true" />
      <Key ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Key = "";
        if (File.Exists(FilePath))
        {
            var lines = File.ReadAllLines(FilePath);
            int idx = LineNumber - 1;
            if (idx >= 0 && idx < lines.Length)
                Key = (lines[idx] ?? "").Trim();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Fails ANY build fast (before compiling) if the Club Log key file is
       missing or the expected line is empty. Debug and Release must behave
       identically here (no exceptions), so a Debug build can never silently
       run without real-time/batch Club Log upload working the same way a
       real end-user Release install does. Unlike the legacy (non-SDK-style)
       project system, the SDK's own implicit tail-import defines its own
       no-op "BeforeBuild"/"AfterBuild" targets AFTER this file's content, so
       reusing those exact names here gets silently overridden and never
       runs. Unique names + explicit BeforeTargets/AfterTargets avoid that. -->
  <Target Name="JimmyClubLogKeyCheck" BeforeTargets="Build">
    <Error Condition="!Exists('$(ClubLogKeyFile)')" Text="Club Log key file not found: $(ClubLogKeyFile). Set up the key file before building." />
    <ReadClubLogKeyLine Condition="Exists('$(ClubLogKeyFile)')" FilePath="$(ClubLogKeyFile)" LineNumber="$(ClubLogKeyLineNumber)">
      <Output TaskParameter="Key" PropertyName="_ClubLogKey" />
    </ReadClubLogKeyLine>
    <Error Condition="Exists('$(ClubLogKeyFile)') and '$(_ClubLogKey)' == ''" Text="Club Log key file exists but line $(ClubLogKeyLineNumber) is empty: $(ClubLogKeyFile). Fix the key file before building." />
  </Target>

  <!-- Embeds Jimmy's Club Log application key into every build's output
       (Debug and Release alike) so real-time/batch upload and country-data
       download work identically regardless of configuration (see
       ClubLogAppKey.cs, resolution option 3). $(_ClubLogKey) was already
       read and validated non-empty by BeforeBuild above; MSBuild properties
       persist across targets within the same build, so it isn't re-read
       here. -->
  <Target Name="JimmyEmbedClubLogKey" AfterTargets="Build">
    <WriteLinesToFile File="$(OutDir)clublog_key.txt" Lines="$(_ClubLogKey)" Overwrite="true" />
  </Target>

  <!-- clublog_key.txt is written straight to $(OutDir) above rather than being a
       tracked MSBuild item, so "dotnet publish" would otherwise never copy it into
       the publish output. This adds it to the publish file set explicitly. -->
  <Target Name="JimmyIncludeClubLogKeyInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)clublog_key.txt" Condition="Exists('$(OutDir)clublog_key.txt')">
        <RelativePath>clublog_key.txt</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
